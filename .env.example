# Copy this file to .env and fill in your values
# Run: cp .env.example .env

# ── LLM ──────────────────────────────────────────────────────────────────────

# Model to use via LiteLLM. Examples:
#   claude-sonnet-4-6              → Anthropic (default)
#   gpt-4o                         → OpenAI
#   gemini/gemini-1.5-pro          → Google Gemini
#   ollama_chat/gemma3:4b          → Ollama cloud
#   ollama/llama3                  → local Ollama (no API key needed)
LLM_MODEL=claude-sonnet-4-6

# Provider API key — set the one that matches LLM_MODEL above
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

# Ollama cloud (https://ollama.com) — only needed if LLM_MODEL=ollama_chat/...
# OLLAMA_API_KEY=your-ollama-api-key
# OLLAMA_API_BASE=https://api.ollama.com

# ── Slack ─────────────────────────────────────────────────────────────────────

# Bot token from https://api.slack.com/apps
# Required OAuth scopes:
#   channels:history, groups:history  — read channel messages
#   channels:read, groups:read        — list joined channels
#   im:write, chat:write              — send, update, and delete DMs
#   reactions:read                    — read emoji reactions (feedback loop)
#   users:read                        — look up user info
SLACK_BOT_TOKEN=xoxb-...

# Your personal Slack user ID (click your profile → ⋮ → Copy member ID)
# The bot uses this to DM you instead of itself
SLACK_USER_ID=U0123456789

# How long (seconds) to wait for a reaction before auto-finalising the draft
# Default: 300 (5 minutes)
# SLACK_FEEDBACK_TIMEOUT=300

# ── GitHub ────────────────────────────────────────────────────────────────────

# Personal access token (needs repo scope)
# https://github.com/settings/tokens
GITHUB_TOKEN=ghp_...
GITHUB_USERNAME=your-github-username

# ── Jira ─────────────────────────────────────────────────────────────────────

# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@yourcompany.com
JIRA_API_TOKEN=your-jira-api-token

# ── Notion ────────────────────────────────────────────────────────────────────

# Internal integration secret from https://www.notion.so/profile/integrations
NOTION_TOKEN=secret_...
