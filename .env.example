# Copy this file to .env and fill in your values
# Run: cp .env.example .env

# LLM Model (via LiteLLM — supports Anthropic, OpenAI, Gemini, Ollama, and more)
# Examples:
#   claude-sonnet-4-6              → Anthropic (default)
#   gpt-4o                         → OpenAI
#   gemini/gemini-1.5-pro          → Google Gemini
#   ollama/llama3                  → local Ollama (no API key needed)
LLM_MODEL=claude-sonnet-4-6

# Provider API Key — set the one that matches your LLM_MODEL
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

# Slack Bot Token (create a bot at https://api.slack.com/apps)
# Required scopes: channels:history, groups:history, im:write, chat:write, users:read, auth:test
SLACK_BOT_TOKEN=xoxb-...

# GitHub Personal Access Token (needs repo scope)
GITHUB_TOKEN=ghp_...
GITHUB_USERNAME=your-github-username

# Jira (https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@yourcompany.com
JIRA_API_TOKEN=your-jira-api-token

# Notion Integration Token (https://www.notion.so/my-integrations)
NOTION_TOKEN=secret_...
